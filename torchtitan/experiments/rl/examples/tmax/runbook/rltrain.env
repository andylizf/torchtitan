# Environment for the reference 9B TerminalWorld run.
#
# Every value here is the value the live run had set, copied from the run's own
# dump (runs/tw-mix-take7-<stamp>/launch.info), not a suggestion. Where a name is
# absent from this file the code default applies and that was deliberate.
#
# systemd reads this via EnvironmentFile=. It is plain KEY=VALUE: no `export`, no
# shell expansion, no quotes-with-spaces. launch_9b.sh reads the same names from
# the ambient environment, so `set -a; . rltrain.env; set +a` works too.
#
# CREDENTIALS ARE NOT IN THIS FILE and must not be added to it. DAYTONA_API_KEY
# (and OPENAI_API_KEY if you run the evolution loop) come from somewhere the repo
# cannot see -- on our box, `. ~/.config/daytona/env` inside the launcher.

# ---- paths (the three things that certainly differ on your machine) ----------
# Root for data, runs, logs, evolution state.
TRL_BASE=/scratch/gpfs/TRIDAO/al9080/terminal-rl
# torchtitan checkout. Goes on PYTHONPATH; NOT pip-installed.
TRL_TT=/home/al9080/torchtitan-yichuan
# Model directory (HF layout, `hf download Qwen/Qwen3.5-9B`).
TRL_MODEL=/scratch/gpfs/TRIDAO/al9080/models/Qwen3.5-9B

# ---- GPU placement ----------------------------------------------------------
# Five GPUs, not eight, because this box is shared with another user -- it is not
# a claim that five is right. The split is SWE_DP_SHARD (trainer) + SWE_GEN_DP
# (generator engines), and they must sum to the GPU count. On an idle 8x B300 the
# obvious change is RL_GPUS=0..7 with a larger SWE_DP_SHARD/SWE_GEN_DP; we have
# not run that, so the numbers below are the ones with evidence behind them.
# RL_GPUS must be CONTIGUOUS: the allocator hands out a consecutive window from
# RL_GPU_OFFSET and silently ignores a non-contiguous list.
RL_GPUS=0,1,2,3,4
RL_GPU_OFFSET=0
SWE_DP_SHARD=2
SWE_GEN_DP=3

# ---- data -------------------------------------------------------------------
SWE_PROMPT_DATA=/scratch/gpfs/TRIDAO/al9080/terminal-rl/data/mix/mix_live.jsonl
SWE_TB2_VAL_DATA=/scratch/gpfs/TRIDAO/al9080/terminal-rl/data/mix/tb2_eval.jsonl
# Re-read the training JSONL mid-run when its mtime changes. Required if the
# evolution loop is running; harmless otherwise.
SWE_DATA_HOT_RELOAD=1

# ---- GRPO shape -------------------------------------------------------------
SWE_NUM_GROUPS_PER_TRAIN_STEP=32
SWE_GROUP_SIZE=16
SWE_MAX_ACTIVE_GROUPS=512
SWE_INITIAL_ACTIVE_GROUPS=64
SWE_SELECTION_WINDOW_GROUPS=64
SWE_TRAIN_STEPS=150
SWE_LR=3e-6
# 0 = KEEP zero-variance groups. Code default is 1 (drop them). Off here because
# the evolution loop re-tunes those prompts instead of discarding them; dropping
# and evolving the same group shrinks the batch by exactly what you meant to fix.
# Running WITHOUT evolution: set this to 1.
SWE_DROP_ZERO_STD=0

# ---- agent and context ------------------------------------------------------
TMAX_AGENT=terminus
TMAX_TERMINUS_MAX_TURNS=120
SWE_MAX_CONTEXT_LEN=63488
TMAX_TURN_MAX_TOKENS=32768
TMAX_EXEC_TIMEOUT_SEC=120
SWE_TIME_BUDGET_SEC=2400
# Raise a task's own declared agent budget to this floor, never lower it. Many
# TerminalWorld tasks declare 900s, far too short for a 120-turn episode.
SWE_AGENT_TIMEOUT_FLOOR_SEC=900

# ---- generator --------------------------------------------------------------
# vllm_native, not torchtitan_wrapper: on B300 the wrapper's varlen path trips
# an FA4-cute assert ("page_table is not supported with cu_seqlens_k").
SWE_GEN_BACKEND=vllm_native
SWE_GPU_MEM_LIMIT=0.85
SWE_MAX_NUM_SEQS=256
SWE_GEN_PREFIX_CACHE=1
SWE_DISABLE_CUSTOM_ALL_REDUCE=1

# ---- rollout throughput -----------------------------------------------------
SWE_ROLLOUT_CONCURRENCY=3072
SWE_NUM_ROLLOUT_WORKERS=16

# ---- reward -----------------------------------------------------------------
# Subtract 0.3 when the agent submits and is wrong. Code default 0 (off).
SWE_WRONG_SUBMIT_PENALTY=0.3

# ---- checkpoints ------------------------------------------------------------
# One 9B checkpoint is ~98 GiB. 24 x 98 GiB is ~2.3 TiB -- size your filesystem
# for it or lower SWE_CKPT_KEEP. The code default is 3.
SWE_CKPT_INTERVAL=5
SWE_CKPT_KEEP=24

# ---- inline validation ------------------------------------------------------
# 0 disables the periodic TB-2.0 pass. It is off here because with no dedicated
# eval generator the pass competes with rollout collection on the same 3 engines.
# To turn it on: SWE_VAL_SAMPLES=89 (the TB-2.0 set is 89 tasks).
SWE_VAL_SAMPLES=0
SWE_VAL_INTERVAL=20
SWE_NUM_EVAL_GENERATORS=0

# ---- Daytona sandboxes ------------------------------------------------------
TT_DAYTONA_EPHEMERAL=1
TT_DAYTONA_CPU=2
TT_DAYTONA_MEM_GB=4
TT_DAYTONA_MAX_MEM_GB=8
TT_DAYTONA_DISK_GB=10
TT_DAYTONA_CREATE_CONCURRENCY=32
TT_DAYTONA_CREATE_RETRIES=8
TT_DAYTONA_HEARTBEAT_SEC=180
TT_DAYTONA_AUTO_DELETE_MIN=15
TT_DAYTONA_LABEL=new_titan_swe_r2e

# ---- evolution loop (optional; see RUNBOOK section G) -----------------------
# The trainer only WRITES here. Unset it and the loop is inert; training is
# unaffected either way.
SWE_TASK_EVOLUTION_DIR=/scratch/gpfs/TRIDAO/al9080/terminal-rl/evolution/signals

# ---- logging ----------------------------------------------------------------
WANDB_PROJECT=terminal-agent-rl
